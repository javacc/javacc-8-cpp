PARSER_BEGIN(ComplexLineComment)
/* keep same number of lines as in the java version
   to get identical test results for Line:Column */





















































PARSER_END(ComplexLineComment)

SKIP : { " " | "\t" | "\n" | "\r" }

TOKEN :
{
   <#NA : ~[ "-", "\r", "\n" ] >
| <#EOL : ( "\n" | "\r" | "\r\n" ) >
| < INTEGER : ( ["0"-"9"] )+ >
}

SPECIAL_TOKEN :
{
  "--" : LineComment
}

< LineComment >
SPECIAL_TOKEN :
{
  < (
      < NA >
    | "-" < NA >
    )*
    (
      < EOL >
    | "-" < EOL >
    | "-" "-"
    )? > : DEFAULT
}

TOKEN :
{
  < Id : [ "a"-"z", "A"-"Z" ] ( [ "a"-"z", "A"-"Z", "0"-"9", "-" ] )* >
  { std::cout << matchedToken->toString() << std::endl; }
}

void Input() :
{}
{
  ( <Id> )*
  // { std::cout << "Finished ID+" << std::endl; std::cerr << System.err.println("Finished ID+" << std::endl; }
  <EOF>
  // { std::cout << "EOF found"    << std::endl; std::cerr << System.err.println("EOF found"    << std::endl; }
}
