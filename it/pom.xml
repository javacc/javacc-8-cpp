<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org</groupId>
    <artifactId>javacc</artifactId>
    <version>8.0.7</version>
    <relativePath></relativePath>
  </parent>
  <groupId>org.javacc.generator.cpp</groupId>
  <artifactId>it</artifactId>
  <packaging>pom</packaging>
  <version>1.0.0</version>
  <name>JavaCC default C++ code generator: it</name>
  <description>JavaCC default C++ code generator: it</description>
  <profiles>
    <profile>
      <id>Windows</id>
      <activation>
        <os>
          <family>Windows</family>
        </os>
      </activation>
      <properties>
        <suffix>exe</suffix>
        <bigobj>/bigobj</bigobj>
        <std />
        <cliargs>/FS</cliargs>
      </properties>
    </profile>
    <profile>
      <id>Linux</id>
      <activation>
        <os>
          <family>Linux</family>
        </os>
      </activation>
      <properties>
        <suffix>sh</suffix>
        <bigobj />
        <std>-std=c++11</std>
        <cliargs />
      </properties>
    </profile>
    <profile>
      <id>MacOS</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <suffix>sh</suffix>
        <bigobj />
        <std>-std=c++11</std>
        <cliargs />
      </properties>
    </profile>
    <profile>
      <id>jcc8</id>
      <activation>
        <file>
          <exists>${basedir}/src/main/javacc</exists>
        </file>
      </activation>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.javacc.plugin</groupId>
              <artifactId>javacc-maven-plugin</artifactId>
              <dependencies>
                <dependency>
                  <groupId>org.javacc.generator</groupId>
                  <artifactId>cpp</artifactId>
                  <version>${javacc.cpp}</version>
                  <scope>runtime</scope>
                </dependency>
              </dependencies>
            </plugin>
          </plugins>
        </pluginManagement>
        <plugins>
          <plugin>
            <groupId>org.javacc.plugin</groupId>
            <artifactId>javacc-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jcc8jcc</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>javacc</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.basedir}/target/generated-sources/cpp</outputDirectory>
                  <sourceDirectory>${project.basedir}/src/main/javacc</sourceDirectory>
                  <codeGenerator>c++</codeGenerator>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.maven-nar</groupId>
            <artifactId>nar-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <libraries>
                <library>
                  <type>executable</type>
                  <run>true</run>
                </library>
              </libraries>
              <cpp>
                <debug>false</debug>
                <defines>
                  <define>JJ8</define>
                </defines>
                <includePaths>
                  <includePath>
                    <path>${project.basedir}/src/main/cpp</path>
                  </includePath>
                  <includePath>
                    <path>${project.basedir}/target/generated-sources/cpp</path>
                  </includePath>
                </includePaths>
                <options>
                  <option>${cliargs}</option>
                  <option>${bigobj}</option>
                  <option>${std}</option>
                </options>
              </cpp>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
