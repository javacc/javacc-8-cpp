/*
 * The class definitions generated by Javacc/cpp (by TokenManagerCodeGenerator.java with
 *  cpp/DefaultTokenManagerErrorHandler.cc.template) that are used when lexical errors
 *  are encountered.
 */

void DefaultTokenManagerErrorHandler::lexicalError(    bool EOFSeen,
                                                        int lexState,
                                                        int errorLine,
                                                        int errorColumn,
                                                   JJString errorAfter,
                                                     JJChar curChar) {
  JJLOG << JJWIDE(Lexical error at line) << JJSPACE << errorLine << JJCOMMA << JJSPACE
        << JJWIDE(column) << JJSPACE << errorColumn << JJWIDE(.) << JJSPACE << JJSPACE
        << JJWIDE(Encountered:) << JJSPACE << JJQUOTE << curChar << JJQUOTE << JJSPACE << JJWIDE(.) << JJWIDE(.) 
        << JJWIDE(after:) << JJSPACE << JJDBQUOTE << errorAfter << JJDBQUOTE << JJWIDE(.) << std::endl;
}

void DefaultTokenManagerErrorHandler::lexicalError(const JJString& errorMessage) {
    JJLOG << errorMessage << std::endl;
}

#if NAMESPACE
${NAMESPACE_CLOSE} // end namespace
