options
{
//  BUILD_PARSER = false;
//  BUILD_TOKEN_MANAGER = false;
//  JAVA_TEMPLATE_TYPE = "modern";
  DEBUG_LOOKAHEAD = true;
  DEBUG_PARSER = true;
//  DEBUG_TOKEN_MANAGER = true;
//  JAVA_UNICODE_ESCAPE = true;
  KEEP_LINE_COLUMN = false;
  NO_DFA = true;
//  PARSER_INCLUDE = "stdio.h";
//  TOKEN_INCLUDE = "<stdio.h>";
//  TOKEN_MANAGER_INCLUDE = "<stdio.h>";
  SANITY_CHECK = false;
  STATIC = false;

  NAMESPACE = "mns";
}

PARSER_BEGIN(Bug)
/* keep same number of lines as in the java version
   to get identical test results for Line:Column */



















































PARSER_END(Bug)

TOKEN_MGR_DECLS : {
  int my_tm_decl;
}

SKIP : { " " | "\t" | "\n" | "\r" }

TOKEN :
{
  < LBRACKET : "[" >
| < RBRACKET : "]" >
| < LBRACE : "{" >
| < RBRACE : "}" >
| < LPAREN : "(" >
| < RPAREN : ")" >
}

TOKEN :
{
  < #UPPER : ["A"-"Z"] > 
| < #LOWER : ["a"-"z"] > 
| < #DIGIT : ["0"-"9"] > 
| < NUMBER : ( "0" | ["1"-"9"] ( < DIGIT > )*) > 
| < #LOWERCASEFIRST : < LOWER > ( "-" ( < LOWER > | < UPPER > | < DIGIT > ) | ( < LOWER > | < UPPER > | < DIGIT > ) )* > 
| < #UPPERCASEFIRST : < UPPER > ( "-" ( < LOWER > | < UPPER > | < DIGIT > ) | ( < LOWER > | < UPPER > | < DIGIT > ) )* >
}

TOKEN :
{
  < IDENTIFIANT : < LOWERCASEFIRST > >
| < VALUEREFERENCE : < UPPERCASEFIRST > >
}
// special 1, 0 leading spaces; to be copied
/* special 2, 0 leading spaces; to be copied */
/** special 3, 0 leading spaces; to be copied */
void EnumerationItem() :
{}
{
  < LBRACE >
  (
    LOOKAHEAD(2)
    NamedNumber()
  |
    identifier()
  )
  < RBRACE >
}

  // special 4, 2 leading spaces; to be copied; and 5 spaces in the next line
     
     /** special 5, 5 leading spaces; to be copied */
void NamedNumber() :
{}
{
  (
    identifier()
  |
    valuereference()
  )
  < LPAREN > < NUMBER > < RPAREN >
}
// special 6, 0 leading spaces, next to last rbrace, to be copied
void identifier() :
{}
{
  < IDENTIFIANT >
} /* special 7, same line as last rbrace with 1 space, to be copied */

void valuereference() :
{}
{
  < VALUEREFERENCE >
}
