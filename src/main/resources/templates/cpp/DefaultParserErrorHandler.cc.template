\#if (JAVACC_CHAR_TYPE_SIZEOF != 1)
using convert_t = std::codecvt_utf8<wchar_t>;

static std::wstring_convert<convert_t, wchar_t> strconverter;

static std::string to_string(const std::wstring& wstr) {
  return strconverter.to_bytes(wstr);
}

static std::wstring to_wstring(const std::string& str) {
  return strconverter.from_bytes(str);
}

\#endif
void DefaultParserErrorHandler::unexpectedToken(const JJString& expectedImage,
                                                const JJString& actualImage,
                                                   const Token* actualToken,
                                                          char* loc) {
  error_count++;
  std::stringstream berr;
  berr << JJWIDE(Encountered:) << JJSPACE
       << addUnicodeEscapes(actualImage) << JJSPACE << JJWIDE(/) << JJSPACE
       << JJDBQUOTE << addUnicodeEscapes(actualToken->image()) << JJDBQUOTE
#if KEEP_LINE_COLUMN
       << JJCOMMA << JJSPACE << JJWIDE(at line) << JJSPACE << actualToken->beginLine()
       << JJCOMMA << JJSPACE << JJWIDE(column) << JJSPACE << actualToken->beginColumn()
#fi
       << JJWIDE(.) << std::endl;
  berr << JJWIDE(Was expecting this terminal) << JJSPACE
       << JJWIDE(within expansion starting at) << JJSPACE << loc << JJWIDE(:) << std::endl;
  berr << addUnicodeEscapes(expectedImage) << JJSPACE << JJWIDE(/) << JJSPACE
       << JJQUOTE << addUnicodeEscapes(expectedImage) << std::endl;
  error_str += berr.str();
}

void DefaultParserErrorHandler::parseError(const Token* last,
                                           const Token* unexpected,
                                  const JJSimpleString& production) {
  error_count++;
  std::stringstream berr;
\#if (JAVACC_CHAR_TYPE_SIZEOF == 1)
  const JJString& work = production;
\#else
  const JJString& work = to_wstring(production);
\#endif
  berr << JJWIDE(Encountered:) << JJSPACE
       << JJQUOTE << addUnicodeEscapes(unexpected->image()) << JJQUOTE
#if KEEP_LINE_COLUMN
       << JJCOMMA << JJSPACE << JJWIDE(at) << JJSPACE << unexpected->beginLine()
       << JJWIDE(:) << unexpected->beginColumn()
#fi
       << JJSPACE  << JJWIDE(while parsing:) << JJSPACE << work << std::endl;
  error_str += berr.str();
}

void DefaultParserErrorHandler::otherError(const JJString& message) {
  std::stringstream berr;
  berr << JJWIDE(Error:) << JJSPACE  << message << std::endl;
  error_str += berr.str();
}

