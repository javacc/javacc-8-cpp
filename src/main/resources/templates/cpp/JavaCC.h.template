/** Abstraction on stream classes to read a block of data into a buffer. */
class ReaderStream {

  public:

  virtual ~ReaderStream() {}
  
  /** Reads block of data into a buffer and return the actual number read. */
  virtual size_t read(JJChar* /*buffer*/, int /*offset*/, size_t /*len*/) { return 0; }
  
  /** To be overriden. */
  virtual bool   endOfInput() { return true; }

};

template<typename TF> struct JJEnter {
  TF fs;
  JJEnter(TF fp) : fs{fp} { fs(); }
  ~JJEnter()              {}
};

template<typename TF> struct JJExit {
  TF fs;
  JJExit(TF fp) : fs{fp} {}
  ~JJExit()              { fs(); }
};

\#define OUT_OF_RANGE 0x0A
template<int size, typename T> struct Array {

  T array[size];
  
  T &operator[](size_t index) {
    if (index >= size)
      throw OUT_OF_RANGE;
    return array[index];
  }
  const T &operator[](size_t index) const {
    if (index >= size)
      throw OUT_OF_RANGE;
    return array[index];
  }
  void* base() {
    return this->array;
  }
  const void* base() const {
    return this->array;
  }
  
};

