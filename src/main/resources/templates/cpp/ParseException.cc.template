/*
 * The class definitions generated by Javacc/cpp (by CppCodeGenerator.java
 *  with cpp/ParseException.cc.template) that are used when parse errors are encountered.
 */

ParseException::ParseException() {
}

ParseException::ParseException(const JJString& message) {
}

ParseException::ParseException(   const Token* currentToken,
                                   const int** expectedTokenSequences,
                               const JJString* tokenImage,
                                    const int* expectedExpansionLine,
                                    const int* expectedExpansionColumn) {
  initialise(currentToken, expectedTokenSequences, tokenImage, expectedExpansionLine, expectedExpansionColumn);
  this->currentToken = currentToken;
  this->expectedTokenSequences = expectedTokenSequences;
  this->tokenImage = tokenImage;
  this->expectedExpansionLine = expectedExpansionLine;
  this->expectedExpansionColumn = expectedExpansionColumn;
}

